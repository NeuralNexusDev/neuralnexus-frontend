package components

import "strings"

const (
	htmxURL       = "https://s3.neuralnexus.dev/cdn/htmx/v4.0.0/htmx.min.js"
	htmxIntegrity = "sha384-BvJpBiO8Kh31EqtJe5DRIeWrHWnCGkwytKs9NKFi86Hhw96dEqdEMzZDeK9iEGTc"
	htmxConfig    = `{"mode":"same-origin","history":false,"allowEmptySwapAfterOOB":true,"defaultSettleDelay":0,"defaultTimeout":60000}`

	mutedClass      = "text-gray-500 dark:text-gray-400"
	mutedXsClass    = mutedClass + " text-xs"
	subtleXsClass   = "text-xs text-muted-foreground"
	mutedSmallClass = mutedClass + " text-sm"
	emptyClass      = mutedSmallClass + " text-center"
	errorTextClass  = "text-sm text-red-600 dark:text-red-400"
	bannerClass     = "rounded-md border border-red-700 bg-red-700/10 p-3 text-sm text-red-700 dark:border-red-400 dark:bg-red-400/10 dark:text-red-400"

	cardClass   = "block rounded-lg border border-input p-3 transition-colors hover:bg-accent hover:text-accent-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
	chipClass   = "rounded-full border border-input px-2.5 py-0.5 text-xs"
	toggleClass = "relative inline-flex h-6 w-11 shrink-0 cursor-pointer items-center rounded-full bg-control ring-offset-background transition-colors has-[:checked]:bg-primary has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-ring has-[:focus-visible]:ring-offset-2 has-[:disabled]:cursor-not-allowed has-[:disabled]:opacity-50"

	checkboxClass = "h-4 w-4 shrink-0 appearance-none rounded border border-control bg-background ring-offset-background checked:border-primary checked:bg-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"

	labelClass  = "text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70"
	inputClass  = "text-foreground flex h-10 w-full rounded-md border border-control bg-background px-3 py-2 text-sm ring-offset-background file:border-0 file:bg-transparent file:text-sm file:font-medium placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50"
	selectClass = "text-foreground flex h-10 w-full rounded-md border border-control bg-background px-3 py-2 text-sm"

	buttonBaseClass = "inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
	buttonClass     = buttonBaseClass + " border border-input hover:bg-accent hover:text-accent-foreground h-9 px-3"
	linkButtonClass = buttonBaseClass + " border border-input hover:bg-accent hover:text-accent-foreground ring-offset-background focus-visible:ring-offset-2 h-10 px-4 py-2 w-full"
	submitClass     = buttonBaseClass + " border hover:bg-primary-light ring-offset-background focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 bg-primary text-primary-foreground h-10 px-4 py-2 w-full"
)

// busyAttrs and selfSwapAttrs mark a region that runs one request at a time. htmx-glue.js finds the region by
// data-busy-region, reads the id of its status line from data-status, and treats the value "replaced" as a region
// whose response redraws every control in it.
var (
	busyAttrs     = templ.Attributes{"data-busy-region": true, "hx-sync:inherited": "this:drop"}
	selfSwapAttrs = templ.Attributes{"data-busy-region": "replaced", "hx-sync:inherited": "this:drop", "hx-target:inherited": "this", "hx-swap:inherited": "outerHTML"}
)

templ htmxHead() {
	<meta name="htmx-config" content={ htmxConfig }/>
	<script src={ htmxURL } integrity={ htmxIntegrity } crossorigin="anonymous" defer></script>
	<script src="/public/js/htmx-glue.js" defer></script>
}

templ htmxPage(title string, contents templ.Component) {
	@WrapContentsWithHead(title, htmxHead(), contents)
}

templ pageShell(width string, statusID string, loadPath string) {
	<div class={ "mx-auto space-y-6 " + width }>
		{ children... }
		@pageError()
		<p id="page-status" role="status" class="sr-only"></p>
		if statusID != "" {
			@pageStatus(statusID)
		}
		@pageLoad(loadPath)
	</div>
}

templ pageHeading(title string, description string) {
	<div class="space-y-2 text-center">
		<h1 class="text-3xl font-bold">{ title }</h1>
		<p class={ mutedClass + " text-balance" }>{ description }</p>
	</div>
}

templ pageError() {
	<div id="page-error" role="alert" class={ bannerClass + " text-center empty:m-0 empty:border-0 empty:p-0" }></div>
}

templ pageStatus(id string) {
	<p id={ id } role="status" class={ emptyClass }></p>
}

templ pageLoad(path string) {
	<div hx-get={ path } hx-trigger="load" hx-swap="outerHTML" data-page-load>
		<p class={ emptyClass }>Loading…</p>
	</div>
}

templ backLink(href string, text string) {
	<a href={ templ.URL(href) } class={ mutedSmallClass + " underline" }>{ text }</a>
}

templ linkPair(leftHref string, leftText string, rightHref string, rightText string) {
	<div class={ mutedSmallClass + " flex justify-between" }>
		<a href={ templ.URL(leftHref) } class="underline">{ leftText }</a>
		<a href={ templ.URL(rightHref) } class="underline">{ rightText }</a>
	</div>
}

templ separator() {
	<div data-orientation="horizontal" role="none" class="shrink-0 bg-gray-100 h-[1px] w-full my-8"></div>
}

templ emptyState(id string, text string) {
	<p id={ id } class={ emptyClass }>{ text }</p>
}

templ mutedNote(id string, text string) {
	<p id={ id } class={ mutedSmallClass }>{ text }</p>
}

templ formField(id string, label string, help string) {
	@fieldWithError(id, label, help, "", false) {
		{ children... }
	}
}

// fieldWithError renders a labelled field. Help and error text get ids built from the field id, which the input
// names in aria-describedby through fieldDescription. A server error replaces the field out of band.
templ fieldWithError(id string, label string, help string, errText string, oob bool) {
	<div
		id={ id + "-field" }
		if oob {
			hx-swap-oob="true"
		}
		class="space-y-2"
	>
		<label class={ labelClass } for={ id }>{ label }</label>
		{ children... }
		if help != "" {
			<p id={ id + "-help" } class={ mutedXsClass }>{ help }</p>
		}
		if errText != "" {
			<p id={ id + "-error" } class={ errorTextClass }>{ errText }</p>
		}
	</div>
}

func fieldDescription(id string, help string, errText string) string {
	var ids []string
	if errText != "" {
		ids = append(ids, id+"-error")
	}
	if help != "" {
		ids = append(ids, id+"-help")
	}
	return strings.Join(ids, " ")
}

templ textInput(id string, name string, value string, placeholder string, required bool, describedBy string, invalid bool) {
	<input
		id={ id }
		name={ name }
		type="text"
		required?={ required }
		if value != "" {
			value={ value }
		}
		if placeholder != "" {
			placeholder={ placeholder }
		}
		if describedBy != "" {
			aria-describedby={ describedBy }
		}
		if invalid {
			aria-invalid="true"
			autofocus
		}
		autocomplete="off"
		autocapitalize="off"
		spellcheck="false"
		class={ inputClass }
	/>
}

templ proseInput(id string, name string, value string) {
	<input
		id={ id }
		name={ name }
		type="text"
		if value != "" {
			value={ value }
		}
		autocomplete="off"
		class={ inputClass }
	/>
}

templ toggle() {
	<label class={ toggleClass }>
		{ children... }
		<span class="pointer-events-none inline-block h-5 w-5 translate-x-0.5 rounded-full bg-background shadow transition-transform peer-checked:translate-x-[22px]"></span>
	</label>
}

templ entityHeader(prefix string, title string, subtitle string, oob bool) {
	<div
		id={ prefix + "-header" }
		if oob {
			hx-swap-oob="true"
		}
		class="space-y-2 text-center"
	>
		<h1 id={ prefix + "-title" } class="text-3xl font-bold">{ title }</h1>
		<p id={ prefix + "-id" } class={ mutedSmallClass + " break-all" }>{ subtitle }</p>
	</div>
}
