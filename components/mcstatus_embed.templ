package components

import (
	"net/url"
	"strconv"
	"strings"

	"github.com/p0t4t0sandwich/neuralnexus-frontend/config"
)

type McStatusEmbedData struct {
	Host    string
	Bedrock bool
	Query   bool
	// QueryPort is 0 when unset.
	QueryPort int
	Online    bool
	Motd      []string
	Players   int
	Max       int
	Version   string
}

func (d McStatusEmbedData) Options() url.Values {
	v := url.Values{}
	if d.Bedrock {
		v.Set("bedrock", "true")
	} else if d.Query {
		v.Set("query", "true")
		if d.QueryPort != 0 {
			v.Set("query_port", strconv.Itoa(d.QueryPort))
		}
	}
	return v
}

func (d McStatusEmbedData) ShareOptions() url.Values {
	v := url.Values{}
	if d.Bedrock {
		v.Set("bedrock", "true")
	} else if !d.Query {
		v.Set("query", "false")
	} else if d.QueryPort != 0 {
		v.Set("query_port", strconv.Itoa(d.QueryPort))
	}
	return v
}

func (d McStatusEmbedData) PageURL() string {
	u := config.SiteURL + "/mcstatus/" + url.PathEscape(d.Host)
	if q := d.ShareOptions().Encode(); q != "" {
		u += "?" + q
	}
	return u
}

func (d McStatusEmbedData) InteractiveURL() string {
	v := d.ShareOptions()
	v.Set("host", d.Host)
	return "/project/mc-status?" + v.Encode()
}

func (d McStatusEmbedData) IconURL() string {
	if !d.Online || d.Bedrock {
		return ""
	}
	return config.APIURL + "/api/v1/mcstatus/icon/" + url.PathEscape(d.Host)
}

const (
	maxEmbedMotdRunes    = 200
	maxEmbedVersionRunes = 64
)

func truncateRunes(s string, max int) string {
	if runes := []rune(s); len(runes) > max {
		return string(runes[:max]) + "…"
	}
	return s
}

func (d McStatusEmbedData) Description() string {
	if !d.Online {
		return "Server offline or unreachable"
	}
	lines := []string{}
	if motd := truncateRunes(strings.Join(d.Motd, "\n"), maxEmbedMotdRunes); motd != "" {
		lines = append(lines, motd)
	}
	lines = append(lines, "Players: "+strconv.Itoa(d.Players)+"/"+strconv.Itoa(d.Max))
	if d.Version != "" {
		lines = append(lines, "Version: "+truncateRunes(d.Version, maxEmbedVersionRunes))
	}
	return strings.Join(lines, "\n")
}

templ McStatusEmbedPage(data McStatusEmbedData) {
	{{ description := data.Description() }}
	@WrapContentsWithHead("IP: "+data.Host, mcStatusEmbedHead(data, description), McStatusEmbed(data, description))
}

templ mcStatusEmbedHead(data McStatusEmbedData, description string) {
	{{ iconURL := data.IconURL() }}
	<meta property="og:site_name" content="Powered by NeuralNexus.dev"/>
	<meta name="theme-color" content="#7C0014"/>
	<meta property="og:title" content={ "IP: " + data.Host }/>
	<meta property="og:description" content={ description }/>
	<meta property="og:url" content={ data.PageURL() }/>
	if iconURL != "" {
		<meta property="og:image" content={ iconURL }/>
	}
}

templ McStatusEmbed(data McStatusEmbedData, description string) {
	<div class="mx-auto max-w-md space-y-4 text-center">
		<h1 class="break-words text-2xl font-bold [overflow-wrap:anywhere]">
			<a class="underline" href={ templ.SafeURL(data.InteractiveURL()) }>{ data.Host }</a>
		</h1>
		<p class="whitespace-pre-line break-words text-sm [overflow-wrap:anywhere]">{ description }</p>
	</div>
}
