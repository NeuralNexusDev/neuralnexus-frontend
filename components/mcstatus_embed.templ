package components

import (
	"net/url"
	"strconv"
	"strings"

	"github.com/p0t4t0sandwich/neuralnexus-frontend/config"
)

// McStatusEmbedData holds the lookup options and server status used for the link-preview tags.
type McStatusEmbedData struct {
	Host      string
	Bedrock   bool
	Query     bool
	QueryPort int
	Online    bool
	Motd      []string
	Players   int
	Max       int
	Version   string
}

// Options returns the API query parameters for the lookup.
func (d McStatusEmbedData) Options() url.Values {
	v := url.Values{}
	if d.Bedrock {
		v.Set("bedrock", "true")
	} else if d.Query {
		v.Set("query", "true")
		if d.QueryPort != 0 {
			v.Set("query_port", strconv.Itoa(d.QueryPort))
		}
	}
	return v
}

// ShareOptions returns the query parameters that appear in shared URLs.
func (d McStatusEmbedData) ShareOptions() url.Values {
	v := url.Values{}
	if d.Bedrock {
		v.Set("bedrock", "true")
	} else if !d.Query {
		v.Set("query", "false")
	} else if d.QueryPort != 0 {
		v.Set("query_port", strconv.Itoa(d.QueryPort))
	}
	return v
}

// PageURL returns the canonical URL of the status page for the server.
func (d McStatusEmbedData) PageURL() string {
	u := config.SiteURL + "/project/mc-status/" + url.PathEscape(d.Host)
	if q := d.ShareOptions().Encode(); q != "" {
		u += "?" + q
	}
	return u
}

// IconURL returns the API icon URL for the host.
func (d McStatusEmbedData) IconURL() string {
	u := config.APIURL + "/api/v1/mcstatus/icon/" + url.PathEscape(d.Host)
	if d.Bedrock {
		u += "?bedrock=true"
	}
	return u
}

const (
	maxEmbedMotdRunes    = 200
	maxEmbedVersionRunes = 64
)

func truncateRunes(s string, max int) string {
	if runes := []rune(s); len(runes) > max {
		return string(runes[:max]) + "…"
	}
	return s
}

// Description returns the text for the og:description tag.
func (d McStatusEmbedData) Description() string {
	if !d.Online {
		return "Server offline or unreachable"
	}
	lines := []string{}
	if motd := truncateRunes(strings.Join(d.Motd, "\n"), maxEmbedMotdRunes); motd != "" {
		lines = append(lines, motd)
	}
	lines = append(lines, "Players: "+strconv.Itoa(d.Players)+"/"+strconv.Itoa(d.Max))
	if d.Version != "" {
		lines = append(lines, "Version: "+truncateRunes(d.Version, maxEmbedVersionRunes))
	}
	return strings.Join(lines, "\n")
}

// McStatusEmbedPage renders the status checker with link-preview tags for data.
templ McStatusEmbedPage(data McStatusEmbedData) {
	@WrapContentsWithHead(data.Host, mcStatusEmbedHead(data), McStatus())
}

templ mcStatusEmbedHead(data McStatusEmbedData) {
	<meta property="og:site_name" content="Powered by NeuralNexus.dev"/>
	<meta property="og:type" content="website"/>
	<meta name="twitter:card" content="summary"/>
	<meta name="robots" content="noindex"/>
	<link rel="canonical" href={ data.PageURL() }/>
	<meta name="theme-color" content="#7C0014"/>
	<meta property="og:title" content={ data.Host }/>
	<meta property="og:description" content={ data.Description() }/>
	<meta property="og:url" content={ data.PageURL() }/>
	<meta property="og:image" content={ data.IconURL() }/>
	<meta property="og:image:alt" content={ data.Host + " server icon" }/>
	<meta property="og:image:width" content="64"/>
	<meta property="og:image:height" content="64"/>
}
