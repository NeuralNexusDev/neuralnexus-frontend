package components

// McStatusEmbedPage renders the status checker with link-preview tags for data.
templ McStatusEmbedPage(data McStatusEmbedData) {
	@WrapContentsWithHead(data.DisplayHost(), mcStatusEmbedHead(data)) {
		@McStatus()
	}
}

templ mcStatusEmbedHead(data McStatusEmbedData) {
	<meta property="og:site_name" content="Powered by NeuralNexus.dev"/>
	<meta property="og:type" content="website"/>
	<meta name="twitter:card" content="summary"/>
	<meta name="robots" content="noindex"/>
	<link rel="canonical" href={ data.PageURL() }/>
	<meta name="theme-color" content="#7C0014"/>
	<meta property="og:title" content={ data.DisplayHost() }/>
	<meta property="og:description" content={ data.Description() }/>
	<meta property="og:url" content={ data.PageURL() }/>
	<meta property="og:image" content={ data.IconURL() }/>
	<meta property="og:image:alt" content={ data.DisplayHost() + " server icon" }/>
	<meta property="og:image:width" content="64"/>
	<meta property="og:image:height" content="64"/>
}
