package components

import "os"

func nnApiURL() string {
	v := os.Getenv("NN_API_URL")
	if v == "" {
		panic("NN_API_URL environment variable must be set")
	}
	return v
}

var NN_API_URL = nnApiURL()

// steamOpenIDLoginURL defaults to the real endpoint - unlike NN_API_URL,
// tests are the only reason to ever override it, so unset shouldn't panic.
func steamOpenIDLoginURL() string {
	v := os.Getenv("STEAM_OPENID_LOGIN_URL")
	if v == "" {
		v = "https://steamcommunity.com/openid/login"
	}
	return v
}

var STEAM_OPENID_LOGIN_URL = steamOpenIDLoginURL()

templ WrapContents(contents templ.Component) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<link rel="stylesheet" href="/public/css/styles.css"/>
			<link rel="apple-touch-icon" sizes="180x180" href="/public/apple-touch-icon.png"/>
			<link rel="icon" type="image/png" sizes="32x32" href="/public/favicon-32x32.png"/>
			<link rel="icon" type="image/png" sizes="16x16" href="/public/favicon-16x16.png"/>
			<link rel="icon" type="image/x-icon" href="/public/favicon.ico"/>
			<link rel="manifest" href="/public/site.webmanifest"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>NeuralNexus</title>
		</head>
		<script src="/public/js/scripts.js"></script>
		<script src="/public/js/theming.js"></script>
		<body>
			<div hidden id="api-base-url">{ NN_API_URL }</div>
			<div hidden id="steam-openid-login-url">{ STEAM_OPENID_LOGIN_URL }</div>
			@Header()
			<div class="relative isolate px-6 pt-14 lg:px-8">
				@contents
			</div>
		</body>
	</html>
}

templ HomePage() {
	@WrapContents(Home())
}

templ Home() {
	@ErrorBanner()
	<h1 class="text-4xl font-bold tracking-tight sm:text-6xl text-red-600">
		NeuralNexus
	</h1>
	<script>
		showAuthErrorFromQuery();
	</script>
}

// ErrorBanner is a hidden, page-level error banner that
// showAuthErrorFromQuery() (scripts.js) reveals when the page was reached
// via an OAuth/OpenID redirect carrying a problem+json error - a nonce
// mismatch or a disallowed redirect_uri lands here (on Home) rather than
// wherever the flow started, since the API can't trust that URI yet.
templ ErrorBanner() {
	<div id="auth-error" hidden class="mx-auto max-w-sm rounded-md border border-destructive bg-destructive/10 p-3 text-sm text-destructive mb-4"></div>
}

templ ThemeToggle() {
    <button onclick="toggleTheme()" class="p-2 rounded-lg bg-red-600 text-white dark:text-black hover:bg-red-700">
        <span id="light-mode">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24">
                <title>material-symbols:light-mode-outline</title>
            	<path fill="currentColor" d="M12 15q1.25 0 2.125-.875T15 12t-.875-2.125T12 9t-2.125.875T9 12t.875 2.125T12 15m0 2q-2.075 0-3.537-1.463T7 12t1.463-3.537T12 7t3.538 1.463T17 12t-1.463 3.538T12 17m-7-4H1v-2h4zm18 0h-4v-2h4zM11 5V1h2v4zm0 18v-4h2v4zM6.4 7.75L3.875 5.325L5.3 3.85l2.4 2.5zm12.3 12.4l-2.425-2.525L17.6 16.25l2.525 2.425zM16.25 6.4l2.425-2.525L20.15 5.3l-2.5 2.4zM3.85 18.7l2.525-2.425L7.75 17.6l-2.425 2.525zM12 12" />
            </svg>
        </span>
        <span id="dark-mode">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24">
                <title>material-symbols:dark-mode-outline</title>
            	<path fill="currentColor" d="M12 21q-3.75 0-6.375-2.625T3 12t2.625-6.375T12 3q.35 0 .688.025t.662.075q-1.025.725-1.638 1.888T11.1 7.5q0 2.25 1.575 3.825T16.5 12.9q1.375 0 2.525-.613T20.9 10.65q.05.325.075.662T21 12q0 3.75-2.625 6.375T12 21m0-2q2.2 0 3.95-1.213t2.55-3.162q-.5.125-1 .2t-1 .075q-3.075 0-5.238-2.163T9.1 7.5q0-.5.075-1t.2-1q-1.95.8-3.163 2.55T5 12q0 2.9 2.05 4.95T12 19m-.25-6.75" />
            </svg>
        </span>
    </button>
}

templ Header() {
	<div class="p-8 flex items-center justify-between mb-8 text-lg text-red-600">
      <div class="flex items-center gap-4">
        <a href="/">NeuralNexus</a>
        <a href="/about">About</a>
        <a href="/contact">Contact</a>
        <a href="/projects">Projects</a>
      </div>

      <div class="flex items-center gap-4">
        @ThemeToggle()
        @LoginButton()
      </div>
    </div>
}

templ projectCardBody(icon string, title string, description string) {
	<div class="flex items-center justify-between">
		<span class="text-3xl" aria-hidden="true">{ icon }</span>
		{ children... }
	</div>
	<div class="space-y-1">
		<h2 class="text-lg font-semibold">{ title }</h2>
		<p class="text-sm text-gray-500 dark:text-gray-400">{ description }</p>
	</div>
}

templ projectCard(href string, icon string, title string, description string) {
	<a
		href={ templ.SafeURL(href) }
		class="flex flex-col gap-4 rounded-lg border border-input p-5 transition-colors hover:bg-accent hover:text-accent-foreground"
	>
		@projectCardBody(icon, title, description) {
			<span class="rounded-full bg-green-100 px-2 py-0.5 text-xs font-medium text-green-800 dark:bg-green-900/40 dark:text-green-300">Live</span>
		}
	</a>
}

templ projectCardSoon(icon string, title string, description string) {
	<div class="flex flex-col gap-4 rounded-lg border border-dashed border-input p-5 opacity-60">
		@projectCardBody(icon, title, description) {
			<span class="rounded-full bg-gray-100 px-2 py-0.5 text-xs font-medium text-gray-600 dark:bg-gray-800 dark:text-gray-300">Coming soon</span>
		}
	</div>
}

templ projectSection(title string, description string) {
	<section class="space-y-4">
		<div class="space-y-1">
			<h2 class="text-2xl font-semibold">{ title }</h2>
			<p class="text-sm text-gray-500 dark:text-gray-400">{ description }</p>
		</div>
		<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
			{ children... }
		</div>
	</section>
}

templ Projects() {
	<div class="mx-auto max-w-4xl space-y-10">
		<div class="space-y-2 text-center">
			<h1 class="text-3xl font-bold">Projects</h1>
			<p class="text-balance text-gray-500 dark:text-gray-400">
				Things I've built and am still tinkering on
			</p>
		</div>
		@projectSection("The APIary", "REST APIs, each with a live demo to poke at") {
			@projectCard("/project/bee-name-generator", "🐝", "Bee Name Generator", "Generate a random bee name, or suggest one of your own")
			@projectCardSoon("⛏️", "MC Status", "Check whether a Minecraft server is online and who's playing")
		}
		if false {
			@projectSection("Other Projects", "Everything that isn't an API") {
				@projectCardSoon("🛠️", "More on the way", "Nothing here yet, but there's plenty in the workshop")
			}
		}
	</div>
}

templ ProjectsPage() {
	@WrapContents(Projects())
}

templ BeeNameGenerator() {
	<script>
		function getBeeName() {
			fetch("https://api.neuralnexus.dev/api/v1/bee-name-generator/name")
				.then((response) => response.json())
				.then((data) => {
					document.getElementById("get-bee-name").innerText = data.name;
				});
		}

		function suggestBeeName(event) {
			event.preventDefault();
			const input = document.getElementById("suggest-bee-name");
			const status = document.getElementById("suggest-bee-status");
			const name = input.value.trim();
			if (!name) {
				return;
			}
			fetch(`https://api.neuralnexus.dev/api/v1/bee-name-generator/suggestion/${encodeURIComponent(name)}`, {
				method: "POST",
			})
				.then((response) => {
					status.textContent = response.ok ? "Thanks for the suggestion!" : "Couldn't submit that, please try again.";
					status.hidden = false;
					if (response.ok) {
						input.value = "";
					}
				})
				.catch(() => {
					status.textContent = "Couldn't submit that, please try again.";
					status.hidden = false;
				});
		}
	</script>
	<div class="mx-auto max-w-sm space-y-6">
		<div class="space-y-2 text-center">
			<h1 class="text-3xl font-bold">Bee Name Generator</h1>
			<p class="text-balance text-gray-500 dark:text-gray-400">
				Generate a random bee name, or suggest one of your own
			</p>
		</div>
		<div class="space-y-4 rounded-lg border border-input p-4 text-center">
			<p class="text-sm text-gray-500 dark:text-gray-400">Your bee name</p>
			<h2 id="get-bee-name" class="min-h-8 text-2xl font-semibold">&mdash;</h2>
			<button
				class="border hover:bg-primary-light inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 bg-primary text-primary-foreground h-10 px-4 py-2 w-full"
				onClick="getBeeName()"
			>
				Generate
			</button>
		</div>
		<div
			data-orientation="horizontal"
			role="none"
			class="shrink-0 bg-gray-100 h-[1px] w-full my-8"
		></div>
		<form class="space-y-4" onsubmit="suggestBeeName(event)">
			<div class="space-y-2">
				<label
					class="text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70"
					for="suggest-bee-name"
				>
					Suggest a name
				</label>
				<input
					class="text-black flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background file:border-0 file:bg-transparent file:text-sm file:font-medium placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50"
					id="suggest-bee-name"
					name="name"
					placeholder="Suggested Name"
					required
					type="text"
				/>
			</div>
			<button
				class="border hover:bg-primary-light inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 bg-primary text-primary-foreground h-10 px-4 py-2 w-full"
				type="submit"
			>
				Suggest
			</button>
			<p id="suggest-bee-status" hidden class="text-center text-sm text-gray-500 dark:text-gray-400"></p>
		</form>
		<a
			id="bee-admin-link"
			hidden
			href="/project/bee-name-generator/admin"
			class="border border-input hover:bg-accent hover:text-accent-foreground inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 h-10 px-4 py-2 w-full"
		>
			Review suggestions
		</a>
	</div>
	<script>
		showBeeAdminLink();
	</script>
}

templ BeeNameGeneratorPage() {
	@WrapContents(BeeNameGenerator())
}

templ BeeNameGeneratorAdmin() {
	<div class="mx-auto max-w-md space-y-6">
		<div class="space-y-2 text-center">
			<h1 class="text-3xl font-bold">Bee Name Suggestions</h1>
			<p class="text-balance text-gray-500 dark:text-gray-400">
				Accept a suggestion to add it to the generator, or reject it to discard it
			</p>
		</div>
		<div id="bee-admin-error" hidden class="rounded-md border border-destructive bg-destructive/10 p-3 text-sm text-destructive"></div>
		<ul id="bee-suggestions" class="space-y-2"></ul>
		<p id="bee-suggestions-empty" hidden class="text-center text-sm text-gray-500 dark:text-gray-400">
			No pending suggestions
		</p>
	</div>
	<script>
		loadBeeSuggestions();
	</script>
}

templ BeeNameGeneratorAdminPage() {
	@WrapContents(BeeNameGeneratorAdmin())
}

