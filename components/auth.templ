package components

import (
	"github.com/p0t4t0sandwich/neuralnexus-frontend/components/button"
	"golang.org/x/oauth2/endpoints"
	"os"
)

var (
	DISCORD_CLIENT_ID    = os.Getenv("DISCORD_CLIENT_ID")
	DISCORD_REDIRECT_URI = os.Getenv("DISCORD_REDIRECT_URI")
	OAUTH2_DISCORD       = templ.SafeURL("https://discord.com/api/oauth2/authorize?client_id=" + DISCORD_CLIENT_ID + "&redirect_uri=" + DISCORD_REDIRECT_URI + "&response_type=code&scope=identify%20email")

	TWITCH_CLIENT_ID    = os.Getenv("TWITCH_CLIENT_ID")
	TWITCH_REDIRECT_URI = os.Getenv("TWITCH_REDIRECT_URI")
	OAUTH2_TWITCH       = templ.SafeURL(endpoints.Twitch.AuthURL + "?client_id=" + TWITCH_CLIENT_ID + "&redirect_uri=" + TWITCH_REDIRECT_URI + "&response_type=code&scope=user%3Aread%3Aemail")

	MICROSOFT_CLIENT_ID    = os.Getenv("MICROSOFT_CLIENT_ID")
	MICROSOFT_REDIRECT_URI = os.Getenv("MICROSOFT_REDIRECT_URI")

	OAUTH2_MICROSOFT = templ.SafeURL("https://login.microsoftonline.com/consumers/oauth2/v2.0/authorize?client_id=" + MICROSOFT_CLIENT_ID + "&redirect_uri=" + MICROSOFT_REDIRECT_URI + "&response_type=code&scope=openid%20profile%20email%20offline_access")

	OAUTH2_XBOX_LIVE = templ.SafeURL("https://login.microsoftonline.com/consumers/oauth2/v2.0/authorize?client_id=" + MICROSOFT_CLIENT_ID + "&redirect_uri=" + MICROSOFT_REDIRECT_URI + "&response_type=code&scope=XboxLive.signin%20offline_access")
)

// Hidden until checkHeaderAuthState() runs - the session cookie is HttpOnly, so the markup can't know.
templ LoginButton() {
	<span id="header-account" hidden class="flex items-center gap-2">
		<span id="header-account-username" class="text-sm font-medium"></span>
		<a href="/account" aria-label="Account settings" class="p-2 rounded-lg hover:bg-red-600 hover:text-white">
			<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24">
				<title>material-symbols:settings-outline</title>
				<path fill="currentColor" d="M9.25 22l-.4-3.2q-.325-.125-.612-.3t-.563-.375L4.7 19.375l-2.75-4.75l2.575-1.95Q4.5 12.5 4.5 12.338v-.675q0-.163.025-.338L1.95 9.375l2.75-4.75l2.975 1.25q.275-.2.575-.375t.6-.3l.4-3.2h5.5l.4 3.2q.325.125.613.3t.562.375l2.975-1.25l2.75 4.75l-2.575 1.95q.025.175.025.338v.675q0 .163-.05.338l2.575 1.95l-2.75 4.75l-2.95-1.25q-.275.2-.575.375t-.6.3l-.4 3.2zm2.75-6.5q1.45 0 2.475-1.025T15.5 12t-1.025-2.475T12 8.5t-2.475 1.025T8.5 12t1.025 2.475T12 15.5"></path>
			</svg>
		</a>
	</span>
	<span id="header-logout-btn" hidden>
		<button
			class="py-2 px-4 rounded-lg bg-red-600 text-black font-bold hover:bg-black hover:text-red-600"
			onclick="logout()"
		>
			Logout
		</button>
	</span>
	<span id="header-login-btn" hidden>
		@button.Button(button.Props{
			Class: "ml-auto py-2 px-4 rounded-lg bg-red-600 text-black font-bold hover:bg-black hover:text-red-600",
			Href:  "/login",
		}) {
			Login
		}
	</span>
	<script>
		checkHeaderAuthState();
	</script>
}

type oauthProvider struct {
	ID         string
	ElementID  string
	Label      string
	Background string
	Hover      string
	Icon       string
	Alt        string
	URL        templ.SafeURL
}

var oauthProviders = []oauthProvider{
	{"discord", "discord-oauth", "Discord", "bg-discord_blurple", "hover:bg-blue-600", "/public/DiscordClydeWhite.svg", "Discord Logo", OAUTH2_DISCORD},
	{"twitch", "twitch-oauth", "Twitch", "bg-twitch_purple", "hover:bg-purple-800", "/public/TwitchGlitchWhite.svg", "Twitch Logo", OAUTH2_TWITCH},
	{"microsoft", "microsoft-oauth", "Microsoft", "bg-microsoft_gray", "hover:bg-black", "/public/MicrosoftLogo.svg", "Microsoft Logo", OAUTH2_MICROSOFT},
	{"xboxlive", "xbox-oauth", "Xbox Live", "bg-xbox_bilbao", "hover:bg-green-800", "/public/XboxSymbolWhite.svg", "Xbox Logo", OAUTH2_XBOX_LIVE},
}

func oauthProviderFor(id string) (oauthProvider, bool) {
	for _, provider := range oauthProviders {
		if provider.ID == id {
			return provider, true
		}
	}
	return oauthProvider{}, false
}

templ oauthBases(prefix string) {
	for _, provider := range oauthProviders {
		<div hidden id={ prefix + provider.ID + "-oauth-base" }>{ provider.URL }</div>
	}
}

templ OAuthButtons(labelPrefix string) {
	@oauthBases("")
	for _, provider := range oauthProviders {
		<a
			href=""
			id={ provider.ElementID }
			data-provider={ provider.ID }
			onclick="startOAuthLogin(this.dataset.provider, document.getElementById(this.dataset.provider + '-oauth-base').innerText); return false;"
		>
			<button class={ buttonBaseClass + " " + provider.Background + " " + provider.Hover + " ring-offset-background focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 bg-background hover:bg-accent hover:text-accent-foreground h-10 px-4 py-2 w-full" }>
				<span class="mr-2 text-white">{ labelPrefix + " " + provider.Label }</span>
				<img src={ provider.Icon } alt={ provider.Alt } class="w-6 h-6 mr-2"/>
			</button>
		</a>
		<div class="mt-2"></div>
	}
	<div class="flex justify-center">
		<a href="" id="steam-oauth" onclick="startOAuthLogin('steam', null); return false;">
			<img src="/public/SteamSignIn.png" alt="Sign in through Steam"/>
		</a>
	</div>
}

// LinkAccountSetup holds what starting to link a platform needs in the browser, which the account rows cannot carry because htmx swaps them.
templ LinkAccountSetup() {
	<script>
    const linkRedirect = window.location.href;
    </script>
	@oauthBases("link-")
}

templ Login() {
	@ErrorBanner()
	<div class="mx-auto max-w-sm space-y-6">
		@pageHeading("Login", "Enter your username or email below to login")
		<div>
			<form class="space-y-4" onSubmit="submitLoginForm()">
				@formField("username", "Username or Email", "") {
					<input
						class={ inputClass }
						id="username"
						name="username"
						placeholder="user@example.com"
						type="text"
					/>
				}
				@formField("password", "Password", "") {
					<input
						class={ inputClass }
						id="password"
						name="password"
						type="password"
					/>
				}
				<button
					class={ submitClass }
					type="submit"
				>
					Login
				</button>
			</form>
			@separator()
			<div class="space-y-4">
				<!-- <button class="w-full">Login with Google</button> -->
				@OAuthButtons("Login with")
				<div class="mt-4 text-center text-sm">
					<span class="mr-1">Don't have an account?</span>
					<a class="underline" href="/register">Sign Up </a>
				</div>
				<a class="inline-block w-full text-center text-sm underline" href="#">
					Forgot your password?
				</a>
			</div>
		</div>
	</div>
	<script>
		showAuthErrorFromQuery();
	</script>
}

templ LoginPage() {
	@WrapContents(Login())
}

templ Register() {
	@ErrorBanner()
	<div class="mx-auto max-w-sm space-y-6">
		@pageHeading("Sign Up", "Enter your information to create an account")
		<div>
			<form class="space-y-4" onSubmit="event.preventDefault()">
				@formField("username", "Username", "") {
					<input
						class={ inputClass }
						id="username"
						name="username"
						placeholder="Username"
						required
						type="text"
					/>
				}
				@formField("email", "Email", "") {
					<input
						class={ inputClass }
						id="email"
						name="email"
						placeholder="user@example.com"
						required
						type="email"
					/>
				}
				@formField("password", "Password", "") {
					<input
						class={ inputClass }
						id="password"
						name="password"
						required
						type="password"
					/>
				}
				@formField("confirm_password", "Confirm Password", "") {
					<input
						class={ inputClass }
						id="confirm_password"
						name="confirm_password"
						required
						type="password"
					/>
				}
				<button
					class={ submitClass }
					type="submit"
				>
					Sign Up
				</button>
			</form>
			@separator()
			<div class="space-y-4">
				@OAuthButtons("Sign up with")
				<div class="mt-4 text-center text-sm">
					<span class="mr-1">Already have an account?</span>
					<a class="underline" href="/login">Login</a>
				</div>
			</div>
		</div>
	</div>
	<script>
		showAuthErrorFromQuery();
	</script>
}

templ RegisterPage() {
	@WrapContents(Register())
}
