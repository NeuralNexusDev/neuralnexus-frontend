package components

templ Account() {
	@ErrorBanner()
	<div class="mx-auto max-w-sm space-y-6">
		<div class="space-y-2 text-center">
			<h1 class="text-3xl font-bold">Account Settings</h1>
			<p class="text-gray-500 dark:text-gray-400">
				Manage your profile and connected sign-in methods
			</p>
		</div>
		<div class="space-y-2">
			<h2 class="text-lg font-semibold">Profile</h2>
			<div class="rounded-md border border-input p-4 text-sm">
				<span class="text-gray-500 dark:text-gray-400">Username:</span>
				<span id="account-username">Loading...</span>
			</div>
		</div>
		<div
			data-orientation="horizontal"
			role="none"
			class="shrink-0 bg-gray-100 h-[1px] w-full my-8"
		></div>
		<div class="space-y-2">
			<h2 class="text-lg font-semibold">Connected Accounts</h2>
			<p class="text-gray-500 dark:text-gray-400 text-sm">
				Link another sign-in method below, or use the Login checkbox and
				Unlink button to manage a method you've already connected.
			</p>
			@LinkAccountButtons()
		</div>
	</div>
	<script>
		showOAuthErrorFromQuery();
		loadAccountProfile();
	</script>
}

templ AccountPage() {
	@WrapContents(Account())
}
