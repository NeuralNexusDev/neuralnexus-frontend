package components

// AccountPlatform is a sign-in platform an account can link.
type AccountPlatform struct {
	ID   string
	Name string
}

// AccountPlatforms are the platforms the account page lists, in order.
var AccountPlatforms = []AccountPlatform{
	{"discord", "Discord"},
	{"twitch", "Twitch"},
	{"microsoft", "Microsoft"},
	{"xboxlive", "Xbox Live"},
	{"steam", "Steam"},
}

// AccountData is what the account page shows.
type AccountData struct {
	Username     string
	PasswordAuth bool
	// SettingsError and LinksError replace the section they name when its lookup failed.
	SettingsError string
	LinksError    string
	// Links maps a platform ID to the account's link to it, and lacks the platforms that are not linked.
	Links map[string]LinkedAccount
}

// AccountSettingsData is the password login setting.
type AccountSettingsData struct {
	PasswordAuth bool
	Error        string
}

const accountToggleClass = "relative inline-flex h-5 w-9 shrink-0 cursor-pointer items-center rounded-full bg-gray-300 transition-colors has-[:checked]:bg-primary has-[:disabled]:cursor-not-allowed has-[:disabled]:opacity-50 dark:bg-gray-600"

// Account renders the account settings page, which loads its content.
templ Account() {
	@ErrorBanner()
	<div class="mx-auto max-w-sm space-y-6">
		<div class="space-y-2 text-center">
			<h1 class="text-3xl font-bold">Account Settings</h1>
			<p class="text-gray-500 dark:text-gray-400">
				Manage your profile and connected sign-in methods
			</p>
		</div>
		@adminError()
		@adminLoad("/account/content")
	</div>
	@LinkAccountSetup()
	<script>
		showAuthErrorFromQuery();
	</script>
}

// AccountContent renders the profile, the sign-in setting and the connected accounts, which the account page loads.
templ AccountContent(d AccountData) {
	<div class="mx-auto max-w-sm space-y-6">
		<div class="space-y-2">
			<h2 class="text-lg font-semibold">Profile</h2>
			<div class="rounded-md border border-input p-4 text-sm">
				<span class="text-gray-500 dark:text-gray-400">Username:</span>
				<span id="account-username">{ d.Username }</span>
			</div>
		</div>
		@adminLoad("/account/admin-link")
		<div
			data-orientation="horizontal"
			role="none"
			class="shrink-0 bg-gray-100 h-[1px] w-full my-8"
		></div>
		<div class="space-y-2">
			<h2 class="text-lg font-semibold">Sign-in Settings</h2>
			@AccountPasswordLogin(AccountSettingsData{PasswordAuth: d.PasswordAuth, Error: d.SettingsError}, false)
		</div>
		<div
			data-orientation="horizontal"
			role="none"
			class="shrink-0 bg-gray-100 h-[1px] w-full my-8"
		></div>
		<div class="space-y-2">
			<h2 class="text-lg font-semibold">Connected Accounts</h2>
			<p class="text-gray-500 dark:text-gray-400 text-sm">
				Link another sign-in method below, or use the Login checkbox and
				Unlink button to manage a method you've already connected.
			</p>
			if d.LinksError != "" {
				<p id="account-links-error" role="alert" class={ adminSectionError }>{ d.LinksError }</p>
			} else {
				<div id="account-links" class="space-y-2">
					for _, platform := range AccountPlatforms {
						@AccountLinkRow(platform, d.Links[platform.ID], d.HasLink(platform.ID), false)
					}
				</div>
			}
		</div>
	</div>
}

// HasLink reports whether the account is linked to the platform.
func (d AccountData) HasLink(platform string) bool {
	_, ok := d.Links[platform]
	return ok
}

// AccountPasswordLogin renders the password login setting, which htmx swaps in after a change, or the out-of-band copy a failed change sends.
templ AccountPasswordLogin(d AccountSettingsData, oob bool) {
	<div
		id="account-password"
		if oob {
			hx-swap-oob="true"
		}
		hx-sync:inherited="this:drop"
		hx-indicator:inherited="this"
		hx-target:inherited="this"
		hx-swap:inherited="outerHTML"
		class={ "space-y-2 " + adminBusyClass }
	>
		<div class="rounded-lg border border-input p-3 flex items-center justify-between">
			<label for="password-auth-enabled" class="text-sm font-medium">
				Password login
			</label>
			<label class={ accountToggleClass }>
				<input
					type="checkbox"
					id="password-auth-enabled"
					name="password_auth"
					value="true"
					checked?={ d.PasswordAuth }
					disabled?={ d.Error != "" }
					hx-post="/account/settings"
					hx-trigger="change"
					class="peer sr-only"
				/>
				<span class="pointer-events-none inline-block h-4 w-4 translate-x-0.5 rounded-full bg-background shadow transition-transform peer-checked:translate-x-4"></span>
			</label>
		</div>
		if d.Error != "" {
			<p id="account-password-error" role="alert" class={ adminSectionError }>{ d.Error }</p>
		}
	</div>
}

// AccountLinkRow renders one platform, linked or not, which htmx swaps in after a change to it, or the out-of-band copy a failed change sends.
templ AccountLinkRow(platform AccountPlatform, link LinkedAccount, linked bool, oob bool) {
	<div
		id={ "link-" + platform.ID }
		if oob {
			hx-swap-oob="true"
		}
		hx-sync:inherited="this:drop"
		hx-indicator:inherited="this"
		hx-target:inherited="this"
		hx-swap:inherited="outerHTML"
		class={ "rounded-lg border border-input p-3 space-y-2 " + adminBusyClass }
	>
		<div class="flex items-center gap-2">
			@accountPlatformIcon(platform.ID)
			<div class="min-w-0 flex-1">
				<div class="flex items-center gap-1">
					<span id={ "link-" + platform.ID + "-title" } class="text-sm font-medium truncate">
						if linked && link.PlatformUsername != "" {
							{ link.PlatformUsername }
						} else {
							{ platform.Name }
						}
					</span>
					<svg
						id={ "link-" + platform.ID + "-verified-icon" }
						class={ "w-4 h-4 shrink-0 text-green-600 dark:text-green-500", templ.KV("hidden", !linked || !link.Verified) }
						xmlns="http://www.w3.org/2000/svg"
						viewBox="0 0 24 24"
					>
						<title>Verified</title>
						<path fill="currentColor" d="M9.55 18L3.85 12.3l1.425-1.425L9.55 15.15l9.175-9.175L20.15 7.4z"></path>
					</svg>
					<span id={ "link-" + platform.ID + "-status" } class="text-xs text-muted-foreground">
						if linked && !link.Verified {
							Unverified
						}
					</span>
				</div>
				<span id={ "link-" + platform.ID + "-subtitle" } class={ "text-xs text-muted-foreground", templ.KV("hidden", !linked) }>
					{ platform.Name }
				</span>
			</div>
			if linked {
				<button
					id={ "link-" + platform.ID + "-action" }
					type="button"
					aria-label={ "Unlink " + platform.Name }
					hx-delete={ "/account/links/" + platform.ID }
					hx-confirm={ "Unlink " + platform.Name + " from your account?" }
					class="shrink-0 text-xs underline"
				>
					Unlink
				</button>
			} else {
				<button
					id={ "link-" + platform.ID + "-action" }
					type="button"
					aria-label={ "Link " + platform.Name }
					data-platform={ platform.ID }
					onclick="handleLinkAction(this.dataset.platform)"
					class="shrink-0 text-xs underline"
				>
					Link
				</button>
			}
		</div>
		<div class="flex items-center justify-between pl-9">
			<label for={ "link-" + platform.ID + "-login-enabled" } class="text-xs text-muted-foreground">
				Allow logins
			</label>
			<label class={ accountToggleClass }>
				@AccountLoginInput(platform, linked && link.LoginEnabled, !linked || !link.Verified, false)
				<span class="pointer-events-none inline-block h-4 w-4 translate-x-0.5 rounded-full bg-background shadow transition-transform peer-checked:translate-x-4"></span>
			</label>
		</div>
	</div>
}

// AccountLoginInput renders the checkbox that allows logins through a platform, or the out-of-band copy a refused change sends.
templ AccountLoginInput(platform AccountPlatform, checked bool, disabled bool, oob bool) {
	<input
		type="checkbox"
		id={ "link-" + platform.ID + "-login-enabled" }
		if oob {
			hx-swap-oob="true"
		}
		aria-label={ "Allow logins for " + platform.Name }
		name="login_enabled"
		value="true"
		checked?={ checked }
		disabled?={ disabled }
		hx-post={ "/account/links/" + platform.ID }
		hx-trigger="change"
		class="peer sr-only"
	/>
}

templ accountPlatformIcon(platform string) {
	switch platform {
		case "discord":
			<div class="flex items-center justify-center w-7 h-7 rounded-md bg-discord_blurple shrink-0">
				<img src="/public/DiscordClydeWhite.svg" alt="Discord Logo" class="w-4 h-4"/>
			</div>
		case "twitch":
			<div class="flex items-center justify-center w-7 h-7 rounded-md bg-twitch_purple shrink-0">
				<img src="/public/TwitchGlitchWhite.svg" alt="Twitch Logo" class="w-4 h-4"/>
			</div>
		case "microsoft":
			<img src="/public/MicrosoftLogo.svg" alt="Microsoft Logo" class="w-5 h-5 shrink-0"/>
		case "xboxlive":
			<div class="flex items-center justify-center w-7 h-7 rounded-md bg-xbox_bilbao shrink-0">
				<img src="/public/XboxSymbolWhite.svg" alt="Xbox Logo" class="w-4 h-4"/>
			</div>
		case "steam":
			<img src="/public/SteamLogo.svg" alt="Steam Logo" class="w-5 h-5 shrink-0 dark:hidden"/>
			<img src="/public/SteamLogoWhite.svg" alt="Steam Logo" class="w-5 h-5 shrink-0 hidden dark:block"/>
	}
}

// AccountPage serves the account settings shell, which loads the profile, the sign-in setting and the connected accounts.
templ AccountPage() {
	@WrapContentsWithHead("NeuralNexus", htmxHead(), Account())
}
