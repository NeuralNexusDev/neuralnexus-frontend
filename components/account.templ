package components

templ Account() {
	@ErrorBanner()
	<div class="mx-auto max-w-sm space-y-6">
		<div class="space-y-2 text-center">
			<h1 class="text-3xl font-bold">Account Settings</h1>
			<p class="text-gray-500 dark:text-gray-400">
				Manage your profile and connected sign-in methods
			</p>
		</div>
		<div class="space-y-2">
			<h2 class="text-lg font-semibold">Profile</h2>
			<div class="rounded-md border border-input p-4 text-sm">
				<span class="text-gray-500 dark:text-gray-400">Username:</span>
				<span id="account-username">Loading...</span>
			</div>
		</div>
		<div
			data-orientation="horizontal"
			role="none"
			class="shrink-0 bg-gray-100 h-[1px] w-full my-8"
		></div>
		<div class="space-y-2">
			<h2 class="text-lg font-semibold">Sign-in Settings</h2>
			<div class="rounded-lg border border-input p-3 flex items-center justify-between">
				<label for="password-auth-enabled" class="text-sm font-medium">
					Password login
				</label>
				<label class="relative inline-flex h-5 w-9 shrink-0 cursor-pointer items-center rounded-full bg-gray-300 transition-colors has-[:checked]:bg-primary has-[:disabled]:cursor-not-allowed has-[:disabled]:opacity-50 dark:bg-gray-600">
					<input
						type="checkbox"
						id="password-auth-enabled"
						disabled
						onchange="setPasswordAuthEnabled(this.checked)"
						class="peer sr-only"
					/>
					<span class="pointer-events-none inline-block h-4 w-4 translate-x-0.5 rounded-full bg-white shadow transition-transform peer-checked:translate-x-4"></span>
				</label>
			</div>
		</div>
		<div
			data-orientation="horizontal"
			role="none"
			class="shrink-0 bg-gray-100 h-[1px] w-full my-8"
		></div>
		<div class="space-y-2">
			<h2 class="text-lg font-semibold">Connected Accounts</h2>
			<p class="text-gray-500 dark:text-gray-400 text-sm">
				Link another sign-in method below, or use the Login checkbox and
				Unlink button to manage a method you've already connected.
			</p>
			@LinkAccountButtons()
		</div>
	</div>
	<script>
		showAuthErrorFromQuery();
		loadAccountProfile();
	</script>
}

templ AccountPage() {
	@WrapContents(Account())
}
